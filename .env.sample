LOG_LEVEL=info
LOG_BATCH=false
LOG_BATCH_SIZE=1000
LOG_BATCH_POLL_INTERVAL=0

RUNTIME_USE_CPUS=0
RUNTIME_MAX_THREADS=0

CACHE_TYPE=memory# dummy, memory, redis, aerospike
CACHE_CONNECTION_STRING=
