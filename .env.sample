HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=30s
HTTP_MAX_REQUEST_BODY_SIZE=33554432
HTTP_NETWORK=tcp
HTTP_ADDRESS=:8080

HEALTHCHECK_GOROUTINE_THRESHOLD=20

DEBUG_INSECURE_SKIP_VERIFY=true

